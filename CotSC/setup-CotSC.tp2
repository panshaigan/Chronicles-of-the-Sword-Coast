// ----------------------------------------------------------
// Optional integration with BP-BGT Worldmap v13.1.1.
// This is a data registration component ONLY: it does not patch
// the built-in EET world map or any CotSC quest scripts.
// Install after CotSC content, before BP-BGT Worldmap component 0.
// ----------------------------------------------------------
BEGIN @6047
REQUIRE_PREDICATE GAME_IS ~eet~ ~The Worldmap integration requires EET.~
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~TORMHA.ARE~ OR FILE_EXISTS_IN_GAME ~QCCGRV.ARE~ OR FILE_EXISTS_IN_GAME ~QCRIVD.ARE~ OR FILE_EXISTS_IN_GAME ~QCHALR.ARE~ OR FILE_EXISTS_IN_GAME ~QCBREW.ARE~ OR FILE_EXISTS_IN_GAME ~QCCARN.ARE~) ~Install the desired CotSC area components first.~

INCLUDE ~CotSC/components/worldmap_compatibility.tph~
